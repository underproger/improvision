{
  "name": "improvision",
  "version": "0.1.0",
  "description": "improvision — static HTML/SCSS markup",
  "scripts": {
    "build": "sass src/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:dev": "sass src/scss/main.scss assets/css/main.css --embed-source-map",
    "watch": "sass --watch src/scss/main.scss assets/css/main.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underproger/improvision.git"
  },
  "bugs": {
    "url": "https://github.com/underproger/improvision/issues"
  },
  "homepage": "https://github.com/underproger/improvision#readme",
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "sass": "^1.108.2"
  },
  "private": true
}