{
  "name": "improvision",
  "version": "0.1.0",
  "description": "improvision — static HTML/SCSS markup",
  "scripts": {
    "build": "npm run css && npm run html",
    "css": "sass src/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "html": "node tools/build-html.mjs",
    "watch": "sass --watch src/scss/main.scss assets/css/main.css",
    "watch:html": "node --watch-path=src/html tools/build-html.mjs",
    "i18n:check": "node tools/build-html.mjs --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underproger/improvision.git"
  },
  "bugs": {
    "url": "https://github.com/underproger/improvision/issues"
  },
  "homepage": "https://github.com/underproger/improvision#readme",
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "node-html-parser": "^9.0.7",
    "sass": "^1.108.2"
  },
  "private": true
}
